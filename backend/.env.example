JIRA_BASE_URL=https://harmony.lge.com:8443/issue
JIRA_API_TOKEN=your_pat_token_here
JIRA_VERIFY_SSL=false

BOARD_ID=12641

# Custom Field IDs (LGE Jira Server)
STORY_POINTS_FIELD=customfield_10808
EPIC_NAME_FIELD=customfield_10804
EPIC_LINK_FIELD=customfield_10801
SPRINT_FIELD=customfield_10800
RELEASE_SPRINT_FIELD=customfield_18834
CHIP_NAME_FIELD=customfield_14922

# 조달 Request DoD (Story DOD_FIELD=18874 와 별도)
PROCUREMENT_DOD_FIELD=customfield_10504

QUALITY_PROJECT_KEY=MLCSIXZERO

# 계획 추적성
ACCEPTANCE_CRITERIA_FIELD=customfield_19604
DOD_FIELD=customfield_18874
PRIORITY_RATIONALE_FIELD=customfield_13449

# 품질 이슈
RESPONSE_PLAN_FIELD=customfield_10901
RESPONSE_ACTION_FIELD=
QUALITY_PROJECT_KEY=

# 리스크 JQL priority (LGE: P0,P1,P2)
RISK_PRIORITIES=P0,P1,P2
# EMV 정량 — Jira Environment 필드 텍스트 파싱
RISK_ENVIRONMENT_FIELD=environment
RISK_SCHEDULE_RESERVE_DAYS=45

# CORS — FE 도메인 (쉼표 구분)
CORS_ORIGINS=http://localhost:3000,https://react-audio.apps.hedej.lge.com,https://workspace.hedej.lge.com

# ── 모델 현황 Snapshot 메일 공유 ─────────────────────────────────────────────
MODEL_SCHEDULE_SHARE_DQA_RECIPIENTS=rokyung.kim@lge.com,seunghwa.kim@lge.com,haengmo.jin@lge.com
MODEL_SCHEDULE_SHARE_DEV_RECIPIENTS=seokmin.koh@lge.com,hyunja.kim@lge.com,sungyeon.cho@lge.com,hongsoon.lee@lge.com,yoonkyu.park@lge.com,jejun.oh@lge.com,sh12.park@lge.com,taeksu.la@lge.com,yongseung.cho@lge.com,maeul.lee@lge.com,pilkyu.yoon@lge.com,jaecheol.lee@lge.com
