# ── Daily Report ─────────────────────────────────────────────────────────────
REPORT_ENABLED=true
REPORT_RECIPIENTS=seokmin.koh@lge.com
REPORT_SUBJECT_PREFIX=[Jira Dashboard]
REPORT_DASHBOARD_URL=https://workspace.hedej.lge.com/your-app
REPORT_API_KEY=

# LGE 내부 relay (TV PMO 스크립트와 동일 패턴 — 무인증, port 25)
SMTP_HOST=lgesmtp.lge.com
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DL-webOS_PMO-AudioSWPO@lge.com
SMTP_USE_TLS=true
SMTP_VERIFY_SSL=false

# ── Milvus (모델 현황 저장 — pymilvus, port 19530) ────────────────────────────
MONGO_HOST=dify-mv-audiojdmtask-milvus.milvus.svc
MONGO_PORT=19530
MONGO_USER=dify-mv-audiojdmtask-admin
MONGO_PASSWORD=
MONGO_DB=dify_mv_audiojdmtask
# 포털 표기 dify-mv-audiojdmtask → Milvus는 하이픈 불가, _ 로 설정 (코드에서 자동 변환도 함)
# 또는 URI: http://user:pass@host:19530

# ── Polarion ALM (H7/M7/W7 MR 품질) ────────────────────────────────────────
POLARION_BASE_URL=https://alm-lge-hlm.singlex.com/polarion/restful/customs/v1
POLARION_PROJECT_KEY=AVSWRelProjMgmt
POLARION_PAT=your_polarion_pat_here
POLARION_VERIFY_SSL=false
