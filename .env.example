# GitLab react-audio (FE) / workspace dev pod용
# BE proxy 자동 유도 시 REACT_APP_API_BASE_URL 비워두기
# Mock/API — 회사 GitLab은 REACT_APP__USE_MOCK (언더스코어 2개) 사용
REACT_APP_USE_MOCK=false
REACT_APP__USE_MOCK=false

# API Base URL (미설정 시 client.ts가 hostname으로 자동 결정)
# - react-audio.apps.hedej.lge.com → be-audio-test (자동)
# - workspace.hedej.lge.com → proxy 또는 be-audio-test (자동)
# - localhost npm run dev → 아래 중 하나 선택:
#
#   회사 BE 사용 (권장 — BE pod에 model_schedule 배포 후):
REACT_APP_API_BASE_URL=https://be-audio-test.apps.hedej.lge.com/api
#
#   로컬 BE 사용 (uvicorn main:app --port 8000 실행 중일 때):
# REACT_APP_API_BASE_URL=http://localhost:8000/api
